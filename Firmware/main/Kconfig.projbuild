menu "Linky Monitor Configuration"

    config LINKY_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID (network name) for the example to connect to.

    config LINKY_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            WiFi password (WPA or WPA2) for the example to use.

    config LINKY_MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtt://192.168.1.100"
        help
            URI of the MQTT broker to connect to.
            Example: mqtt://192.168.1.100 or mqtts://mqtt.example.com

    config LINKY_MQTT_USERNAME
        string "MQTT Username"
        default ""
        help
            Username for MQTT broker authentication (leave empty if not required).

    config LINKY_MQTT_PASSWORD
        string "MQTT Password"
        default ""
        help
            Password for MQTT broker authentication (leave empty if not required).

    config LINKY_MQTT_TOPIC_PREFIX
        string "MQTT Topic Prefix"
        default "linky"
        help
            Prefix for MQTT topics. Topics will be: <prefix>/iinst, <prefix>/base, <prefix>/vcap

    config LINKY_RX_GPIO
        int "Linky RX GPIO"
        default 14
        help
            GPIO number for Linky TIC serial input (RX).
            Must be an RTC-capable GPIO: 0, 2, 4, 12-15, 25-27, 32-39

    config LINKY_USE_STATIC_IP
        bool "Use Static IP (faster connection)"
        default n
        help
            Use static IP instead of DHCP for faster initial connection.

    config LINKY_STATIC_IP
        string "Static IP Address"
        default "192.168.1.200"
        depends on LINKY_USE_STATIC_IP
        help
            Static IP address to use.

    config LINKY_STATIC_GATEWAY
        string "Gateway Address"
        default "192.168.1.1"
        depends on LINKY_USE_STATIC_IP
        help
            Gateway IP address.

    config LINKY_STATIC_NETMASK
        string "Netmask"
        default "255.255.255.0"
        depends on LINKY_USE_STATIC_IP
        help
            Network mask.

    config LINKY_DEBUG_LOGS
        bool "Enable debug logging"
        default n
        help
            Enable verbose debug logs for troubleshooting.
            Disable in production for cleaner logs.

endmenu
